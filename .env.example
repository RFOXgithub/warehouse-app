# Database
POSTGRES_USER=warehouse
POSTGRES_PASSWORD=ganti-password-database
POSTGRES_DB=warehouse
DB_PORT=5432

# Backend saat berjalan di Docker (host database = "db", nama service di docker-compose)
DATABASE_URL=postgres://warehouse:ganti-password-database@db:5432/warehouse
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter
JWT_EXPIRES_IN=8h
SEED_SUPERVISOR_PASSWORD=ganti-password-supervisor
SEED_OPERATOR_PASSWORD=ganti-password-operator